import pandas as pd     
import matplotlib.pyplot as plt


def extract_runC2(filepath: str) -> pd.DataFrame:
    columns = [
        "calls",
        "avg_usec",
        "worst_usec",
        "worst_call_at",
        "ge_limit",
        "ge_limit_half",
        "function",
    ]

    rows = []

    with open(filepath, "r") as f:
        for line in f:
            # find the target row
            if "runC2" in line:
                # split table columns
                parts = [p.strip() for p in line.split("|")]

                # defensive check (expected 7 columns)
                if len(parts) != 7:
                    continue

                rows.append({
                    "calls": int(parts[0]),
                    "avg_usec": int(parts[1]),
                    "worst_usec": int(parts[2]),
                    "worst_call_at": int(parts[3]),
                    "ge_limit": int(parts[4]),
                    "ge_limit_half": int(parts[5]),
                    "function": parts[6],
                })

    return pd.DataFrame(rows, columns=columns)

def plot_runC2_histograms(
    df_a,
    df_b,
    label_a="Dataset A",
    label_b="Dataset B",
    bins=10,
):
    """
    Plot histograms comparing runC2 timing metrics.

    Parameters
    ----------
    df_a, df_b : pandas.DataFrame
        Must contain columns:
            - avg_usec
            - worst_usec

    label_a, label_b : str
        Legend labels.

    bins : int
        Histogram bin count.
    """

    # ---- avg_usec histogram ----
    plt.figure()
    plt.hist(df_a["avg_usec"], bins=bins, alpha=0.5, label=label_a)
    plt.hist(df_b["avg_usec"], bins=bins, alpha=0.5, label=label_b)

    plt.title("Histogram of avg_usec")
    plt.xlabel("avg_usec")
    plt.ylabel("Frequency")
    plt.legend()
    plt.pause(0.1)

    # ---- worst_usec histogram ----
    plt.figure()
    plt.hist(df_a["worst_usec"], bins=bins, alpha=0.5, label=label_a)
    plt.hist(df_b["worst_usec"], bins=bins, alpha=0.5, label=label_b)

    plt.title("Histogram of worst_usec")
    plt.xlabel("worst_usec")
    plt.ylabel("Frequency")
    plt.legend()
    plt.pause(0.1)


